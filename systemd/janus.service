# Janus MCP gateway — systemd --user unit (REST + networked surface).
#
# Self-sufficiency / Logout Test (constitution §12): no interactive-shell
# dependency. Secrets come from EnvironmentFile only; ExecStartPre (--check)
# fails loudly if a required endpoint or secret is missing, so the unit never
# starts in a silently-degraded state.
#
# Install (operator, break-glass):
#   cp systemd/janus.service ~/.config/systemd/user/
#   # create ~/.config/systemd/user/op-creds.env  (mode 0600): OP_SERVICE_ACCOUNT_TOKEN=...
#   # create ~/.config/systemd/user/janus.env     (mode 0600): JANUS_* endpoints + JANUS_TOKENS
#   systemctl --user daemon-reload
#   systemctl --user enable --now janus.service
#   loginctl enable-linger "$USER"   # survive logout (Logout Test)

[Unit]
Description=Janus MCP gateway / capability broker
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify (was simple) + WatchdogSec (infra-gn2q). On 2026-08-03 the gateway
# wedged for ~20 minutes while this unit reported "active (running)" the whole
# time: a downstream 503 livelocked the asyncio event loop at 100% CPU, so the
# process was alive but served nothing, and SIGTERM could not even be handled —
# systemd had to SIGKILL it at the stop timeout (infra-8r1x).
#
# "The process exists" is not liveness for an asyncio server. The gateway now
# sends READY=1 only once the socket is genuinely servable, and heartbeats
# WATCHDOG=1 from a task ON the event loop. If that loop is starved by this
# livelock or any future one, the heartbeat stops, WatchdogSec expires, and
# systemd kills and restarts the unit instead of leaving it hung and green.
Type=notify
NotifyAccess=main
WatchdogSec=45
WorkingDirectory=%h/IDE/projects/janus
# '-' tolerates a missing file so the unit can start; --check below is what
# actually enforces that required secrets are present (fail-loud, not silent).
EnvironmentFile=-%h/.config/systemd/user/op-creds.env
EnvironmentFile=-%h/.config/systemd/user/janus.env
ExecStartPre=%h/IDE/projects/janus/.venv/bin/python -m janus --check
ExecStart=%h/IDE/projects/janus/.venv/bin/python -m janus --serve
# Restart=always (not on-failure): uvicorn exits status=0 even on a fatal
# 'Application startup failed', so on-failure would NOT self-heal a transient
# startup error (e.g. a boot-time DNS race before a downstream is reachable).
# always + RestartSec makes systemd retry until the dependency is up (infra-b7g).
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
